	@$(QMAKE) -spec macx-xcode "$(EXPORT__PRO_FILE_)" CONFIG+=release

sub-dependencies-praaline-dependencies-pro-check_ordered:
	@test -d dependencies/ || mkdir -p dependencies/
	cd dependencies/ && ( test -e Makefile.praaline-dependencies || $(QMAKE) -o Makefile.praaline-dependencies /Users/nj/Downloads/Praaline-0.9.10-source/dependencies/praaline-dependencies.pro CONFIG+=release ) && $(MAKE) -f Makefile.praaline-dependencies check
sub-pncore-check_ordered: sub-dependencies-praaline-dependencies-pro-check_ordered 
	@test -d pncore/ || mkdir -p pncore/
	cd pncore/ && ( test -e Makefile || $(QMAKE) -o Makefile /Users/nj/Downloads/Praaline-0.9.10-source/pncore/pncore.pro CONFIG+=release ) && $(MAKE) -f Makefile check
