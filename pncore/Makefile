DESTDIR       = build/release/
TARGET        = libpncore.1.0.0.dylib
TARGETA       = build/release/libpncore.a
TARGET0       = libpncore.dylib
TARGETD       = libpncore.1.0.0.dylib
TARGET1       = libpncore.1.dylib
TARGET2       = libpncore.1.0.dylib

####### Custom Variables
EXPORT_VALID_ARCHS = arm64
EXPORT_DEFAULT_ARCHS = arm64
EXPORT_ARCHS = $(filter $(EXPORT_VALID_ARCHS), $(if $(ARCHS), $(ARCHS), $(if $(EXPORT_DEFAULT_ARCHS), $(EXPORT_DEFAULT_ARCHS), $(EXPORT_VALID_ARCHS))))
EXPORT_ARCH_ARGS = $(foreach arch, $(if $(EXPORT_ARCHS), $(EXPORT_ARCHS), $(EXPORT_VALID_ARCHS)), -arch $(arch))
EXPORT__PRO_FILE_ = /Users/nj/Downloads/Praaline-0.9.10-source/pncore/pncore.pro


first: all
####### Build rules

build/release/libpncore.1.0.0.dylib:  $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	@test -d build/release/ || mkdir -p build/release/
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) build/release/$(TARGET)
	-$(MOVE) $(TARGET) build/release/$(TARGET)
	-$(DEL_FILE) build/release/$(TARGET0)
	-$(DEL_FILE) build/release/$(TARGET1)
	-$(DEL_FILE) build/release/$(TARGET2)
	-$(MOVE) $(TARGET0) build/release/$(TARGET0)
	-$(MOVE) $(TARGET1) build/release/$(TARGET1)
	-$(MOVE) $(TARGET2) build/release/$(TARGET2)



